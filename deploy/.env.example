# Wird von setup.sh nach .env kopiert; die Passwörter erzeugt setup.sh zufällig.
# Nur Buchstaben und Ziffern in Passwörtern (das DB-Passwort steckt in einer URL).

SPOTISTATS_DB_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# 127.0.0.1 = Grafana nur auf der shitbox erreichbar; für das Heimnetz die LAN-IP der shitbox eintragen.
GRAFANA_BIND=127.0.0.1

# Anzeigename des Benutzers in der Datenbank (auch beim Import mit --user verwenden)
SPOTISTATS_USER=noah

# Spotify-App (Dashboard: developer.spotify.com). Die Redirect-URI muss dort exakt eingetragen sein.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/callback
